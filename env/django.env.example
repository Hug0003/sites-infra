# Copier en env/crushbrito.env et env/pizzamama.env sur le serveur (jamais dans Git), puis chmod 600.
# Nouvelle clé (une différente par appli) : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Adresse de l'admin Django, difficile à deviner, avec un / final (ex. gestion-k3x9p2/).
DJANGO_ADMIN_PATH=
